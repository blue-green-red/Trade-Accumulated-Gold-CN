# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会提交）

# 微信推送，二选一（都填时优先 PushPlus）
PUSHPLUS_TOKEN=          # https://www.pushplus.plus 微信扫码登录后获取，免费额度较大
SERVERCHAN_SENDKEY=      # https://sct.ftqq.com 微信扫码获取，免费版每天条数很少

# AI 消息面分析：有 API key 用 API；没有则自动复用本机已登录的 Claude Code（claude -p，计入订阅用量）
ANTHROPIC_API_KEY=
# GOLD_AI_BACKEND=auto                    # Claude 分析师后端：auto / api / claude_code
# GOLD_AI_ANALYSTS=claude,codex           # 同一轮串行判断、轮换先后顺序；避免两个 CLI 同时占用内存
# 模型开关在网页中设置并持久化；当前只生成研究、真实账户人工建议和公众内容
# GOLD_CODEX_MODEL=                       # 留空用 Codex 默认模型
# GOLD_AI_MAX_BUDGET_USD=3                # claude_code 单次调用上限（按官网价折算）
# GOLD_AI_MODEL=claude-opus-5-5
# GOLD_AI_SCHEDULE=08:40,20:45           # 工作日定时分析（北京时间），另有价格变化与事件触发
# GOLD_AI_VIEW_MAX_AGE_HOURS=13          # 短线用的 AI 判断有效期
# GOLD_JIN10_ENABLED=1                    # 金十数据快讯（金十网页版公开接口，非官方 API）
# GOLD_JIN10_AI_DAILY_CAP=4               # 每天最多因金十重要快讯触发 AI 的次数
# GOLD_AI_EVENT_DELAY_MINUTES=10         # 美国重要数据公布后多久加跑 AI
# GOLD_AI_MAX_SEARCHES=2                  # 每模型每轮按需补搜；CLI 次数由提示词约束，API 为工具硬上限

# 网页看板（monitor.web）
# GOLD_WEB_HOST=127.0.0.1               # 默认只允许本机访问；改为 0.0.0.0 对外时必须设置密码
# GOLD_WEB_PORT=8080
# GOLD_WEB_PASSWORD=                     # 至少 12 位；浏览器弹窗登录（用户名任意）；同一登录可操作模型开关

# 境外数据源代理（默认本机 Clash；设为空则直连）
# 数据采集与通知直连；以下代理仅注入模型CLI或模型API客户端
# GOLD_TRADING_HTTP_PROXY=http://127.0.0.1:7890

# 可选调参（括号内为默认值）
# GOLD_MONITOR_STRATEGIES=position_ai,short_ai  # 仅兼容旧版 AI 账户；规则账户已移除
# GOLD_MONITOR_ACCOUNT_BUDGET=100000      # 每个日线策略账户的虚拟本金（元）
# GOLD_MONITOR_TICK_SECONDS=60            # 每轮间隔秒数
# 常驻监控不启动银行Chromium；京东执行报价由接口直取
# GOLD_MONITOR_SELL_FEE_RATE=0.004        # 卖出手续费率（浙商/民生均 0.4%）
# GOLD_MONITOR_SPREAD_CNY=0               # 买卖价差（两家均为单一报价）
# GOLD_MONITOR_PAPER_BANK=zheshang        # 模拟盘银行：zheshang / minsheng
# GOLD_MONITOR_PAPER_GRAMS=10             # 模拟盘每笔克数
# GOLD_MONITOR_MOVE_WINDOW_MINUTES=30     # 价格异动窗口（分钟），仅触发内部AI复评，不发微信
# GOLD_MONITOR_MOVE_PCT=0.6               # 价格异动阈值 %
# GOLD_MONITOR_MOVE_COOLDOWN_MINUTES=60   # 同方向行情异动事件冷却，记录保留在系统事件中

# 京东黄金参考数据（仅触发 AI 分析时获取，缓存 15 分钟；密钥勿提交）
# CLAWX_JR_API_KEY=

# GOLD_MONITOR_FX_REFRESH_MINUTES=15       # 人民币汇率刷新间隔

# 当前模式：仅研究、真实账户人工建议及公众内容，模拟实验已停用
GOLD_AI_TRADING_MODE=live_only
# GOLD_AI_DECISION_MAX_AGE_MINUTES=15     # 超过此输入年龄不接收新决策
# GOLD_AI_SHORT_REVIEW_MINUTES=0         # 0不限制间隔；负数关闭周期复查
# GOLD_AI_PERIODIC_MIN_MOVE_PCT=0.4      # 较上次AI输入的金价变化百分比
# GOLD_AI_REVIEW_MAX_IDLE_MINUTES=240    # 无显著变化时最长等待
# GOLD_AI_MAX_RUNS_PER_DAY=120            # 每模型自动调用上限，成功/失败/取消都计入
# GOLD_AI_PAGE_FETCH_MAX_CALLS=2          # 网页读取失败时，本轮额外直抓正文上限；0关闭，补搜关闭时也停用
# GOLD_AI_URGENT_RESERVE=2               # 最后两轮只允许重大事件

# 京东参考接口：两个模型/资金与挂单接口共享每日预算（北京时间），失败也计入
# GOLD_JD_RESEARCH_MAX_REQUESTS_PER_DAY=10 # 本地后台预算，不是供应商剩余额度；0关闭请求

# 京东真实账户只读采集；使用本人登录会话，与ClawX参考接口额度独立
# GOLD_JD_LIVE_QUOTE_SECONDS=60          # 两家银行报价，开市期间
# GOLD_JD_LIVE_REFRESH_SECONDS=300       # 持仓、电子户余额、条件单及最近交易
# GOLD_JD_LIVE_HISTORY_SECONDS=1800      # 持仓批次与清仓记录首页

# GOLD_WEB_MIN_PASSWORD_LENGTH=12        # 对外访问密码最短长度，默认12，下限8

# AI 输入精简与调用统计；设0恢复完整输入/较长说明
# GOLD_AI_OPTIMIZE=1
# Codex 有界会话续接；实测累计上下文增加消耗，默认关闭，设1试用
# GOLD_CODEX_RESUME=0
# GOLD_CODEX_SESSION_MAX_TURNS=6          # 达到轮数后新建会话
# GOLD_CODEX_SESSION_MAX_MINUTES=240     # 最长会话年龄，跨北京时间日期也重建

# 分析期间：京东报价或XAU/USD相对输入达到该涨跌幅，旧决策失效并排队复查
# 与0.4%的常规复查阈值独立；不取消正在生成的模型调用，不绕过每日调用预算
# GOLD_AI_INFLIGHT_MAX_MOVE_PCT=0.4

# 每模型每轮只读账户历史查询上限；默认6，0关闭；每次默认5条、最多10条
# GOLD_AI_HISTORY_MAX_QUERIES=6
