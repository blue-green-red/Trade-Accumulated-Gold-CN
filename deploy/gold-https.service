[Unit]
Description=Gold dashboard HTTPS reverse proxy
After=network-online.target gold-web.service
Wants=network-online.target gold-web.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/gold.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/gold.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -t -c /etc/nginx/gold.conf
ExecReload=/usr/sbin/nginx -c /etc/nginx/gold.conf -s reload
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
MemoryMax=64M

[Install]
WantedBy=multi-user.target
